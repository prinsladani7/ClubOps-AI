# ======================================================================
# ClubOps AI - Environment Configuration Template
# Bit N Build Hackathon 2026 - Operational Command Center
# ======================================================================

# Port for local dev server (default: 3000)
PORT=3000

# Application Metadata
NEXT_PUBLIC_APP_NAME="ClubOps AI"
NEXT_PUBLIC_APP_URL="http://localhost:3000"

# AI Provider Configuration (Optional - Defaults to built-in autonomous heuristic engine)
# Supported: gemini, openai, local-simulation
AI_PROVIDER="gemini"
GEMINI_API_KEY=""
OPENAI_API_KEY=""

# Optional Database & Storage Integration (Optional - Defaults to Zero-Config in-memory store)
# If connecting to external Supabase / PostgreSQL:
NEXT_PUBLIC_SUPABASE_URL=""
NEXT_PUBLIC_SUPABASE_ANON_KEY=""
SUPABASE_SERVICE_ROLE_KEY=""

# Security & Session Settings
SESSION_SECRET="clubops_hackathon_super_secret_jwt_key_2026"
NEXT_PUBLIC_ENABLE_AUDIT_LOGGING="true"

# =====================================================================
# CLUBOPS AI - ENVIRONMENT CONFIGURATION TEMPLATE
# =====================================================================
# Copy this file to .env.local for local overrides.
# Default values are optimized to run out-of-the-box on any laptop.

PORT=3000
NODE_ENV=development

# Application Metadata
NEXT_PUBLIC_APP_NAME="ClubOps AI"
NEXT_PUBLIC_APP_DESCRIPTION="The AI Operating System for College Club Events & Bit N Build Hackathon 2026"
NEXT_PUBLIC_APP_URL="http://localhost:3000"

# Optional: Gemini API Key for dynamic live AI chat features
# If omitted, ClubOps AI uses its built-in rule-based operational synthesis engine
GEMINI_API_KEY=""

# Optional: Supabase configuration (if connecting to persistent remote database)
NEXT_PUBLIC_SUPABASE_URL=""
NEXT_PUBLIC_SUPABASE_ANON_KEY=""
